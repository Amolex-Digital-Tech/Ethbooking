{
  "name": "ethiopianbooking",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "postinstall": "node scripts/prisma-generate.mjs",
    "preview": "PRISMA_CLIENT_RUNTIME=cloudflare opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "PRISMA_CLIENT_RUNTIME=cloudflare opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "PRISMA_CLIENT_RUNTIME=cloudflare opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "prebuild": "node scripts/prisma-generate.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.55.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wrangler": "^4.164.0"
  }
}
