{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Wraps .open-next/worker.js to add the Cron Trigger handler below.
  "main": "custom-worker.ts",
  "name": "ethiopianbooking",
  "compatibility_date": "2026-11-17",
  // Keep variables set in the Cloudflare dashboard when deploying from Git.
  // Without this, `wrangler deploy` deletes dashboard plain-text variables.
  "keep_vars": true,
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ethiopianbooking"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Expire unpaid bookings and release their rooms every 5 minutes
  // (handled by `scheduled` in custom-worker.ts). The GitHub Actions
  // workflow .github/workflows/expire-bookings.yml remains as a fallback.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
